#!/usr/bin/env bash
set -Eeuo pipefail
source /opt/chatbot/ops/lib.sh
require_docker
require_root
ensure_runtime_dirs
acquire_operation_lock
[[ -f "$CHATBOT_CURRENT_RELEASE" ]] || die "canonical deployment is not initialized; run ops/migrate-legacy prepare"
require_canonical_live_mode
verify_release_images "$CHATBOT_CURRENT_RELEASE"
live_compose "$CHATBOT_CURRENT_RELEASE" config --quiet
live_compose "$CHATBOT_CURRENT_RELEASE" up -d --no-build --wait --wait-timeout 240
/opt/chatbot/ops/smoke live
