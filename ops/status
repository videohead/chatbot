#!/usr/bin/env bash
set -Eeuo pipefail
source /opt/chatbot/ops/lib.sh
require_docker
phase=$(migration_phase_if_any)
if [[ "$phase" == rolled-back || "$phase" == preparing || "$phase" == prepared ]]; then
  printf 'Legacy deployment is live; migration phase: %s\n\n' "$phase"
  /opt/chatbot/ops/inventory
  exit 0
fi
[[ -f "$CHATBOT_CURRENT_RELEASE" ]] || die "canonical deployment is not initialized; run ops/migrate-legacy prepare"
verify_live_release "$CHATBOT_CURRENT_RELEASE"
live_compose "$CHATBOT_CURRENT_RELEASE" ps
printf '\n'
/opt/chatbot/ops/smoke live
