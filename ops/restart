#!/usr/bin/env bash
set -Eeuo pipefail
source /opt/chatbot/ops/lib.sh
require_docker
require_root
acquire_operation_lock
[[ -f "$CHATBOT_CURRENT_RELEASE" ]] || die "canonical deployment is not initialized"
require_canonical_live_mode
verify_live_release "$CHATBOT_CURRENT_RELEASE"
live_compose "$CHATBOT_CURRENT_RELEASE" up -d --no-build --force-recreate --wait --wait-timeout 240
/opt/chatbot/ops/smoke live
