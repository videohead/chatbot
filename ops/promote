#!/usr/bin/env bash
set -Eeuo pipefail
source /opt/chatbot/ops/lib.sh
require_docker
require_root
ensure_runtime_dirs
acquire_operation_lock

tested="$CHATBOT_RUNTIME/tested.env"
validate_release_file "$tested"
[[ -f "$CHATBOT_CURRENT_RELEASE" ]] \
  || die "canonical deployment is not initialized; use ops/migrate-legacy for the first cutover"

if docker inspect chatbot >/dev/null 2>&1 || \
   docker inspect media-litellm-candidate >/dev/null 2>&1 || \
   docker inspect chatbot-workspace-blechdom >/dev/null 2>&1; then
  die "legacy chatbot containers still exist; use ops/migrate-legacy promote for the first cutover"
fi

/opt/chatbot/ops/smoke candidate "$tested"
verify_tested_release "$tested"
current_backup="$CHATBOT_RUNTIME/current.before-promote.$$"
verify_live_release "$CHATBOT_CURRENT_RELEASE"
[[ "$(release_id_from_file "$tested")" != "$(release_id_from_file "$CHATBOT_CURRENT_RELEASE")" ]] \
  || die "the tested release is already live; build a new release before promotion"
install -o root -g optusers -m 0640 "$CHATBOT_CURRENT_RELEASE" "$current_backup"
atomic_copy "$CHATBOT_CURRENT_RELEASE" "$CHATBOT_PREVIOUS_RELEASE"

restore_previous=false
restore_on_failure() {
  local status=$? recovery_failed=false
  trap - EXIT INT TERM
  if [[ "$restore_previous" == true && -f "$current_backup" ]]; then
    if ! atomic_copy "$current_backup" "$CHATBOT_CURRENT_RELEASE" \
      || ! live_compose "$CHATBOT_CURRENT_RELEASE" up -d --no-build --force-recreate --wait --wait-timeout 240 \
      || ! /opt/chatbot/ops/smoke live; then
      recovery_failed=true
      printf 'URGENT: automatic restoration of the preceding chatbot release failed. Retained release file: %s\n' \
        "$current_backup" >&2
    fi
  fi
  if [[ "$recovery_failed" == false && -e "$current_backup" ]]; then
    rm -- "$current_backup"
  fi
  [[ "$recovery_failed" == false ]] || exit 1
  exit "$status"
}
trap restore_on_failure EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

atomic_copy "$tested" "$CHATBOT_CURRENT_RELEASE"
restore_previous=true
live_compose "$CHATBOT_CURRENT_RELEASE" config --quiet
live_compose "$CHATBOT_CURRENT_RELEASE" up -d --no-build --force-recreate --wait --wait-timeout 300
/opt/chatbot/ops/smoke live
restore_previous=false
trap - EXIT INT TERM
[[ -e "$current_backup" ]] && rm -- "$current_backup"
if ! test_compose "$tested" down --remove-orphans; then
  printf 'Warning: production is healthy, but the loopback candidate could not be removed; run sudo /opt/chatbot/ops/cleanup.\n' >&2
fi
if ! rm -f -- "$CHATBOT_PENDING_RELEASE" "$CHATBOT_RUNTIME/tested.env" "$CHATBOT_TESTED_MANIFEST"; then
  printf 'Warning: production is healthy, but stale pending/tested release pointers remain.\n' >&2
fi
printf 'The tested release is live on port 3000. Traefik and databases were unchanged.\n'
