#!/usr/bin/env bash
set -Eeuo pipefail
source /opt/chatbot/ops/lib.sh
require_docker
require_root
acquire_operation_lock

release_file=$CHATBOT_PENDING_RELEASE
[[ -f "$release_file" ]] || release_file=$CHATBOT_CURRENT_RELEASE
if [[ -f "$release_file" ]]; then
  test_compose "$release_file" down --remove-orphans >/dev/null 2>&1 || true
fi

action=${1:-}
if [[ -z "$action" ]]; then
  printf '%s\n' \
    'The fixed chatbot-test project was removed.' \
    'No production container, image, database, secret, or rollback artifact was removed.'
  exit 0
fi

if [[ "$action" == --retire-releases ]]; then
  require_canonical_live_mode
  verify_live_release "$CHATBOT_CURRENT_RELEASE"
  declare -A protected=()
  for reference in \
    "$CHATBOT_CURRENT_RELEASE" "$CHATBOT_PREVIOUS_RELEASE" \
    "$CHATBOT_PENDING_RELEASE" "$CHATBOT_RUNTIME/tested.env"; do
    if [[ -f "$reference" ]]; then
      protected["$(release_id_from_file "$reference")"]=1
    fi
  done
  if [[ -f "$CHATBOT_RUNTIME/migration.env" ]]; then
    load_migration_file
    if [[ "$MIGRATION_PHASE" != retired && -f "$MIGRATION_RELEASE_FILE" ]]; then
      protected["$(release_id_from_file "$MIGRATION_RELEASE_FILE")"]=1
    fi
  fi

  retired=0
  shopt -s nullglob
  for release in "$CHATBOT_RUNTIME/releases/"*.env; do
    release_id=$(release_id_from_file "$release")
    [[ -z ${protected[$release_id]+x} ]] || continue
    load_release_file "$release"
    in_use=false
    for image in "$CHATBOT_WEB_IMAGE" "$CHATBOT_MEDIA_IMAGE" "$CHATBOT_WORKSPACE_IMAGE"; do
      if [[ -n "$(docker ps -aq --filter ancestor="$image")" ]]; then
        in_use=true
      fi
    done
    [[ "$in_use" == false ]] || continue
    removal_failed=false
    for image in "$CHATBOT_WEB_IMAGE" "$CHATBOT_MEDIA_IMAGE" "$CHATBOT_WORKSPACE_IMAGE"; do
      if docker image inspect "$image" >/dev/null 2>&1 \
        && ! docker image rm "$image" >/dev/null; then
        removal_failed=true
      fi
    done
    [[ "$removal_failed" == false ]] || continue
    rm -f -- \
      "$release" \
      "$(release_manifest_path "$release")" \
      "$(release_compose_path "$release")" \
      "$(release_test_compose_path "$release")" \
      "$(release_policy_path "$release")"
    retired=$((retired + 1))
  done
  printf 'Retired %d unreferenced immutable chatbot release(s); current, previous, pending, tested, migration, and in-use releases were retained.\n' "$retired"
  exit 0
fi

[[ "$action" == --retire-legacy ]] \
  || die "usage: $0 [--retire-legacy|--retire-releases]"

require_canonical_live_mode
verify_live_release "$CHATBOT_CURRENT_RELEASE"
/opt/chatbot/ops/smoke live
load_migration_file
[[ ${MIGRATION_PHASE:-} == promoted ]] || die "legacy migration is not in promoted state"

for record in \
  "$LEGACY_WEB_BACKUP|$LEGACY_WEB_ID" \
  "$LEGACY_MEDIA_BACKUP|$LEGACY_MEDIA_ID" \
  "$LEGACY_WORKSPACE_BACKUP|$LEGACY_WORKSPACE_ID"; do
  IFS='|' read -r container expected_id <<<"$record"
  [[ "$(docker inspect --format '{{.Id}}' "$container" 2>/dev/null || true)" == "$expected_id" ]] \
    || die "legacy rollback identity changed: $container"
  [[ "$(docker inspect --format '{{.State.Status}}' "$container")" == exited ]] \
    || die "legacy rollback container is not safely stopped: $container"
done
for container in "$LEGACY_WEB_BACKUP" "$LEGACY_MEDIA_BACKUP" "$LEGACY_WORKSPACE_BACKUP"; do
  docker rm "$container" >/dev/null
done

tmp="${CHATBOT_RUNTIME}/migration.env.tmp.$$"
awk '/^MIGRATION_PHASE=/{print "MIGRATION_PHASE=retired"; next} {print}' \
  "$CHATBOT_RUNTIME/migration.env" >"$tmp"
chown root:optusers "$tmp"
chmod 0640 "$tmp"
mv -T -- "$tmp" "$CHATBOT_RUNTIME/migration.env"
printf '%s\n' \
  'The three exact stopped legacy chatbot containers were removed.' \
  'Current and previous images, databases, credentials, and private historical records were retained.'
