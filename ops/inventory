#!/usr/bin/env bash
set -Eeuo pipefail
source /opt/chatbot/ops/lib.sh
require_docker

printf '%-34s %-18s %-12s %s\n' NAME PROJECT STATE IMAGE
for container in $(docker ps -a --format '{{.Names}}'); do
  case "$container" in
    chatbot*|media-litellm-candidate)
      docker inspect --format '{{.Name}}|{{index .Config.Labels "com.docker.compose.project"}}|{{.State.Status}}|{{.Config.Image}}' "$container" \
        | sed 's#^/##' | awk -F'|' '{printf "%-34s %-18s %-12s %s\n",$1,$2,$3,$4}'
      ;;
  esac
done

printf '\nPublished chatbot listeners:\n'
docker ps --format '{{.Names}}|{{.Ports}}' \
  | awk -F'|' '$2 ~ /(3000|15008)->3000/ {printf "  %s  %s\n",$1,$2}'

printf '\nHost mounts used by running chatbot services (contents are not read):\n'
for container in chatbot media-litellm-candidate chatbot-workspace-blechdom \
  chatbot-web-1 chatbot-media-1 chatbot-workspace-1; do
  docker inspect "$container" >/dev/null 2>&1 || continue
  docker inspect --format '{{.Name}}{{range .Mounts}}{{println "\n  " .Source " -> " .Destination}}{{end}}' "$container" \
    | sed 's#^/##'
done
