# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****
NEXT_PUBLIC_SERVICE_ORIGIN=https://videohead.duckdns.org

# required for non-vercel deployments, vercel uses OIDC automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****

# Local model broker and multiagent harness
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_API_KEY=****
LITELLM_MCP_SERVER=metis_router
CHATBOT_ENABLE_DIRECT_MCP_TOOLS=false
AGENT_FRAMEWORK_URL=http://agent-framework:8000

# Optional application-user to local-Linux-user ownership mapping for media.
MEDIA_LOCAL_OWNER_USER_ID=
MEDIA_LOCAL_OWNER_UID=
MEDIA_LOCAL_OWNER_GID=

# Optional chat memory: store large messages/tool outputs and retrieve them
# into context via Postgres full-text search. Defaults to disabled.
CHATBOT_MEMORY_ENABLED=false
# CHATBOT_MEMORY_CHUNK_CHARS=6000
# CHATBOT_MEMORY_CHUNK_OVERLAP_CHARS=600
# CHATBOT_MEMORY_PROMPT_CHARS=4096
# CHATBOT_MEMORY_MIN_CONTENT_CHARS=2000
